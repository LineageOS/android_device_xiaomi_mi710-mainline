/*
```bash
clear
for i in adsp.b{00..29} cdsp.b{00..10} modem.b{00..29} venus.b{00..04}; do
echo "install_symlink {
    name: \"symlink_firmware_pyxis_${i}\",
    device_specific: true,
    installed_location: \"firmware/qcom/sdm710/pyxis/${i}\",
    symlink_target: \"/vendor/firmware_mnt/image/${i}\",
}
"
done
```

```bash
clear
for i in adsp.b{00..29} cdsp.b{00..10} modem.b{00..29} venus.b{00..04}; do
echo "        \"symlink_firmware_pyxis_${i}\","
done
```
*/

