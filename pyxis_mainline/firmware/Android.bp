    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/venus.b00",
    symlink_target: "/vendor/firmware_mnt/image/venus.b00",
}

install_symlink {
    name: "symlink_firmware_pyxis_venus.b01",
    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/venus.b01",
    symlink_target: "/vendor/firmware_mnt/image/venus.b01",
}

install_symlink {
    name: "symlink_firmware_pyxis_venus.b02",
    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/venus.b02",
    symlink_target: "/vendor/firmware_mnt/image/venus.b02",
}

install_symlink {
    name: "symlink_firmware_pyxis_venus.b03",
    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/venus.b03",
    symlink_target: "/vendor/firmware_mnt/image/venus.b03",
}

install_symlink {
    name: "symlink_firmware_pyxis_venus.b04",
    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/venus.b04",
    symlink_target: "/vendor/firmware_mnt/image/venus.b04",
}

genrule {
    name: "gen_firmware_pyxis_ipa_fws.mbn",
    tools: ["pil-squasher"],
    out: ["ipa_fws.mbn"],
    cmd: "$(location pil-squasher) $(out) ../../../../../vendor/xiaomi/sdm710-common/proprietary/vendor/firmware/ipa_fws.mdt",
}

prebuilt_firmware {
    name: "firmware_pyxis_ipa_fws.mbn",
    src: ":gen_firmware_pyxis_ipa_fws.mbn",
    filename_from_src: true,
    device_specific: true,
    sub_dir: "qcom/sdm710/pyxis",
}

// Workaround soong installing device_specific prebuilt_firmware module to /odm/etc/firmware
install_symlink {
    name: "symlink_firmware_pyxis_ipa_fws.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sdm710/pyxis/ipa_fws.mbn",
    symlink_target: "/odm/etc/firmware/qcom/sdm710/pyxis/ipa_fws.mbn",
}

