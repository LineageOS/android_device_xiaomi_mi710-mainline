install_symlink {
    name: "symlink_firmware_pyxis",
    vendor: true,
    installed_location: "firmware/qcom/sdm710/xiaomi/pyxis",
    symlink_target: "/odm/firmware/qcom/sdm710/xiaomi/pyxis",
}

phony {
    name: "all_symlink_firmware_pyxis",
    required: [
        "symlink_firmware_pyxis",
    ],
}
