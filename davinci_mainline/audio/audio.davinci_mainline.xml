<audiohal>
    <mixer card="0">
    </mixer>
    <device name="speaker">
        <path name="on">
        </path>
        <path name="off">
        </path>
        <path name="pcm_on">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <stream type="pcm" dir="out" card="0" device="0">
        <enable path="pcm_on"/>
        <disable path="pcm_off"/>
    </stream>
</audiohal>
